    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "sex_survival = df.groupby('Sex')['Survived'].mean() * 100\n",
        "\n",
        "ax = sex_survival.plot(kind='bar')\n",
        "\n",
        "plt.title('Titanic Survival Rate by Sex')\n",
        "plt.xlabel('Sex')\n",
        "plt.ylabel('Survival Rate (%)')\n",
        "plt.ylim(0, 100)\n",
        "plt.xticks(rotation=0)\n",
        "\n",
        "for i, value in enumerate(sex_survival):\n",
        "    plt.text(i, value + 2, f'{value:.1f}%', ha='center')\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
